– meaning that elements can be of different data types, such as strings, integers, and even other lists\n\n\nPython comes with a module built-in, array, which can be used to create arrays in Python. While arrays maintain most of the characteristics of Python lists, they cannot store items of different data types. They also have additional properties including:\n\n* Numerical operations\n* Memory Efficiency: suitable for large number of elements in a single data type\n* Fewer Operations\n* Better and Faster Performance\"\"\"\n\n\n\n# Creating a python array\nimport array\ndays_array = array.array('i',[1,2,3,4,5])    #'i'is a byte code that signifies that the array contains integers\n# print(days_array)\n\n# look up the byte code for atrings and other data types if you want to declare them in an array\n\n\n\n# Arrays are also wayyy more efficient than Python lists\nimport time\nimport array\n\nlist1 = [64,55,37,90,12]\nlist2 = [44,65,27,99,20]\nresult = 0\n\nstart_time1 = time.time()\n\nfor i in range(len(list1)):\n    result += list1[i] * list2[i]\n# print(result)\nend_time1 = time.time()\nelapsed_time1 =  end_time1 - start_time1 \n\n\nprint(f'Time taken when using python lists is {elapsed_time1} seconds')\n\n\n\n# Using the array module\narray1 = array.array('i', [6,5,3,9,1])\narray2 = array.array('i', [4,6,7,9,2])\nresult = 0\n\nstart_time2 = time.time()\n\nfor i in range(len(array1)):\n    result += array1[i] * array2[i]\n# print(result)\nend_time2 = time.time()\nelapsed_time2 = end_time2 - start_time2 \n\n\nprint(f'Time taken when using python arrays is {elapsed_time2} seconds')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-17T20:42:11.090297Z","iopub.execute_input":"2026-09-17T20:42:11.09065Z","iopub.status.idle":"2026-09-17T20:42:11.11589Z","shell.execute_reply.started":"2026-09-17T20:42:11.09061Z","shell.execute_reply":"2026-09-17T20:42:11.114984Z"}},"outputs":[{"name":"stdout","text":"Time taken when using python lists is 0.00011396408